{
	"name": "dwdb",
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "pnpm api:build && pnpm frontend:typecheck && pnpm frontend:build",
		"lint": "pnpm api:lint && pnpm frontend:lint && pnpm lint:md",
		"lint:md": "markdownlint-cli2",
		"format": "pnpm api:format && pnpm frontend:format",
		"test": "pnpm api:test",
		"prepare": "husky",
		"api:dev": "dotenv -e .env -- tsx watch api/src/index.ts",
		"api:build": "pnpm typecheck && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"api:start": "node dist/api/src/index.js",
		"api:migrate:create": "dotenv -e .env -- node-pg-migrate create --migrations-dir api/migrations",
		"api:migrate:up": "dotenv -e .env -- node-pg-migrate up --migrations-dir api/migrations",
		"api:migrate:down": "dotenv -e .env -- node-pg-migrate down --migrations-dir api/migrations",
		"api:wiki:download": "tsx scripts/download-wiki.ts",
		"api:wiki:download:test": "MAX_PAGES=50 tsx scripts/download-wiki.ts",
		"api:seed": "dotenv -e .env -- tsx api/seeds/seed.ts",
		"api:seed:eras": "dotenv -e .env -- tsx api/seeds/seed-01-eras.ts",
		"api:seed:seasons": "dotenv -e .env -- tsx api/seeds/seed-02-seasons.ts",
		"api:seed:episodes": "dotenv -e .env -- tsx api/seeds/seed-03-episodes.ts",
		"api:lint": "eslint api/src/ api/seeds/ scripts/ tests/ types/",
		"api:format": "prettier --write api/src/ api/seeds/ scripts/ tests/ types/",
		"api:test": "vitest run",
		"frontend:dev": "cd frontend && pnpm dev",
		"frontend:build": "cd frontend && pnpm build",
		"frontend:lint": "cd frontend && pnpm lint",
		"frontend:format": "cd frontend && pnpm format",
		"frontend:typecheck": "cd frontend && pnpm typecheck"
	},
	"dependencies": {
		"@fastify/cors": "^11.3.0",
		"@fastify/swagger": "^9.7.0",
		"@fastify/swagger-ui": "^5.2.6",
		"@fastify/type-provider-typebox": "^6.1.0",
		"@sinclair/typebox": "^0.34.49",
		"fastify": "^5.8.5",
		"fastify-plugin": "^5.1.0",
		"postgres": "^3.4.4"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"dotenv-cli": "^8.0.0",
		"eslint": "^10.2.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"husky": "^9.1.7",
		"markdownlint-cli2": "^0.23.2",
		"node-pg-migrate": "^8.0.4",
		"prettier": "^3.8.3",
		"tsc-alias": "^1.9.2",
		"tsx": "^4.19.0",
		"typescript": "^5.4.0",
		"typescript-eslint": "^8.59.0",
		"vitest": "^3.2.4"
	}
}
